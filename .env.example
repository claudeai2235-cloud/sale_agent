# ── Required ─────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / any Postgres). Use the *pooled* URL on Vercel.
DATABASE_URL=
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# 32+ random characters each. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_SECRET=
# Used once on /setup to create the Super Admin account
SETUP_SECRET=
# Protects /api/cron (follow-ups, learning, billing reminders)
CRON_SECRET=
# Public URL of this app, e.g. https://thiri.vercel.app  (needed for Telegram webhooks & media links)
APP_URL=

# ── Facebook Messenger (one Meta App for all businesses) ──
META_APP_SECRET=
META_VERIFY_TOKEN=
# Optional: lets the bot ignore its own echo messages faster
META_APP_ID=
# Optional: Graph API version (default v23.0)
GRAPH_API_VERSION=
